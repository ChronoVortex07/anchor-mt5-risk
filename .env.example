# Copy to .env, chmod 600. Use random hex for DB password (URL-safe).
POSTGRES_PASSWORD=replace-with-random-hex
DATABASE_URL=postgresql+psycopg://risk:replace-with-random-hex@127.0.0.1:5432/risk
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# 32+ random characters. Must match Telegram setWebhook secret_token.
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=https://risk.example.com
PUBLIC_HOST=risk.example.com
ACME_EMAIL=ops@example.com
DEV_PORT=18089
# Standalone VPS only; do not use when another proxy already binds these ports.
PUBLIC_BIND=0.0.0.0
